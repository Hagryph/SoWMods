cmake_minimum_required(VERSION 3.21)
set(root "${CMAKE_CURRENT_BINARY_DIR}/headless-mod-fixture")
file(MAKE_DIRECTORY "${root}/NewMod/nested")
foreach(sample IN ITEMS "int ok;" "ImGui::Button();" "#include <HagUIAPI.h>" "CreateWindowExW();")
    file(WRITE "${root}/NewMod/nested/sample.cpp" "${sample}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DMOD_ROOT=${root}" -P "${CMAKE_CURRENT_LIST_DIR}/HeadlessMods.cmake"
        RESULT_VARIABLE rc ERROR_VARIABLE why)
    if(sample STREQUAL "int ok;")
        if(NOT rc EQUAL 0)
            message(FATAL_ERROR "${why}")
        endif()
    elseif(rc EQUAL 0 OR NOT why MATCHES "Submods register actions")
        message(FATAL_ERROR "Guard did not diagnose: ${sample}")
    endif()
endforeach()
