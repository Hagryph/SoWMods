# Run in script mode, including on incremental DLL builds.
cmake_minimum_required(VERSION 3.21)
function(check_tree dir)
    file(GLOB entries LIST_DIRECTORIES true "${dir}/*")
    foreach(path IN LISTS entries)
        get_filename_component(name "${path}" NAME)
        if(IS_DIRECTORY "${path}")
            if(NOT IS_SYMLINK "${path}" AND NOT EXISTS "${path}/CMakeCache.txt" AND NOT name MATCHES "^(build|cmake-build-.*|vcpkg_installed|[.]git)$")
                check_tree("${path}")
            endif()
        elseif(name MATCHES "[.](c|cc|cpp|cxx|h|hh|hpp|hxx|inc|inl|ixx|rc)$" OR name STREQUAL "CMakeLists.txt")
            file(READ "${path}" source)
            string(TOLOWER "${source}" source)
            if(source MATCHES "(hagui|imgui|nuklear[.]h|qtwidgets|createwindow(ex)?[aw]?[ \t\r\n]*[(]|(create)?dialog(box)?(indirect)?(param)?[aw]?[ \t\r\n]*[(]|add(facetedactionlist|subpagebutton|headerbutton|popupeditor|settingtoggle)|registersubpage|setpageonfirstopen)")
                message(FATAL_ERROR "Submods register actions; UI belongs to the loader. Found '${CMAKE_MATCH_1}' in ${path}")
            endif()
        endif()
    endforeach()
endfunction()
if(NOT DEFINED MOD_ROOT)
    set(MOD_ROOT "${CMAKE_CURRENT_LIST_DIR}/../mods")
endif()
check_tree("${MOD_ROOT}")
